# Two H100 94GB on one node, hybrid: a 2-way FSDP actor and two vLLM engines
# time-share both GPUs (engines sleep while the actor trains). Made for the 8B
# when four H100s were not available (2026-10-10). Memory per GPU with the
# engine awake: the fp32 params+grads shard of an 8B (8.2B x 8 B / 2 = 33 GiB)
# stays resident, so Adam goes to CPU (fused CPU AdamW, as single_h100 does for
# the 4B) and the engine takes 0.55 x 94 GB; Adam on the GPU would need 66 GiB
# per rank and leave the engine no KV cache. Ray runs isolated (shared node).
: "${HYBRID:=1}" "${ACTOR_GPUS:=2}" "${VLLM_ENGINES:=2}" "${ISOLATED_RAY:=1}"
: "${RAY_NUM_GPUS:=2}" "${RAY_NUM_CPUS:=24}" "${NUM_GPUS:=2}" "${EVAL_GPU_COUNT:=2}" "${GPU_IDS:=0,1}"
: "${ALLOW_NON_LUSTRE:=1}"
: "${ATTN_IMPLEMENTATION:=te}" "${PACKING:=1}" "${CUDNN_FRONTEND_CUDART_LIB_NAME:=libcudart.so.13}"
: "${FSDP_OFFLOAD:=optimizer}" "${VLLM_UTIL:=0.55}" "${VLLM_PREFIX_CACHING:=1}"
: "${VLLM_MAX_BATCHED_TOKENS:=10000}" "${VLLM_ENFORCE_EAGER:=0}"
: "${OMP_NUM_THREADS:=16}" "${MKL_NUM_THREADS:=16}" "${TOKENIZERS_PARALLELISM:=false}"
# Rollout runners: the Ray CPU budget less the hybrid bundle, the router and
# the engines' own threads (single_h100's rule, 2..16).
if [ -z "${NUM_RUNNERS:-}" ]; then
  NUM_RUNNERS=$(( RAY_NUM_CPUS - 8 ))
  (( NUM_RUNNERS >= 2 )) || NUM_RUNNERS=2
  (( NUM_RUNNERS <= 16 )) || NUM_RUNNERS=16
fi
: "${TORCH_COMPILE_DISABLE:=1}" "${PYTORCH_CUDA_ALLOC_CONF:=expandable_segments:False}"
export HYBRID ACTOR_GPUS VLLM_ENGINES ISOLATED_RAY RAY_NUM_GPUS RAY_NUM_CPUS NUM_GPUS EVAL_GPU_COUNT GPU_IDS
export ALLOW_NON_LUSTRE ATTN_IMPLEMENTATION PACKING CUDNN_FRONTEND_CUDART_LIB_NAME FSDP_OFFLOAD
export VLLM_UTIL VLLM_PREFIX_CACHING VLLM_MAX_BATCHED_TOKENS VLLM_ENFORCE_EAGER
export OMP_NUM_THREADS MKL_NUM_THREADS TOKENIZERS_PARALLELISM TORCH_COMPILE_DISABLE PYTORCH_CUDA_ALLOC_CONF NUM_RUNNERS
