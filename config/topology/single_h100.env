# One H100 (80 or 94 GB). One FSDP rank and one vLLM engine time-share the GPU;
# Ray runs isolated so other Ray clusters on the node are untouched. Transformer
# Engine (env/pins.sh) comes from scripts/bootstrap.sh, or from
# scripts/build_te_single_h100.sh where the system compiler is too old, so
# attention and packing match the multi-GPU runs. cuDNN frontend must use CUDA 13's runtime.
: "${HYBRID:=1}" "${ACTOR_GPUS:=1}" "${VLLM_ENGINES:=1}" "${ISOLATED_RAY:=1}"
: "${RAY_NUM_GPUS:=1}" "${RAY_NUM_CPUS:=12}" "${NUM_GPUS:=1}" "${EVAL_GPU_COUNT:=1}" "${GPU_IDS:=0}"
: "${ALLOW_NON_LUSTRE:=1}"
: "${ATTN_IMPLEMENTATION:=te}" "${PACKING:=1}" "${CUDNN_FRONTEND_CUDART_LIB_NAME:=libcudart.so.13}"
# Memory split between the actor and the engine follows the policy's size and
# the card's size (ga_grpo/model_profile.py --single-rank-shell): the engine
# sleeps while the actor trains, but the fp32 actor stays resident while the
# engine generates.
#                 H100 80GB                      H100 94GB
#   Qwen3-0.6B    Adam on GPU, vLLM 0.75         Adam on GPU, vLLM 0.80
#   Qwen3-4B      Adam on CPU, vLLM 0.50         Adam on CPU, vLLM 0.55
# (fused CPU AdamW; the 4B's fp32 params+grads are ~30 GB.) An exported
# FSDP_OFFLOAD / VLLM_UTIL / SINGLE_GPU_GIB still wins. Without a readable
# model (eval launchers, a missing MODELS_DIR) the 80GB 4B split applies.
if [ -z "${SINGLE_GPU_GIB:-}" ]; then
  # No GPU here (a login node): nvidia-smi fails, and an assignment from a failing
  # substitution would end a `set -e` caller, so the failure is swallowed.
  _jg_mib="$( (nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null || true) | head -1 | tr -d ' ')"
  [[ "$_jg_mib" =~ ^[0-9]+$ ]] && SINGLE_GPU_GIB="$(awk "BEGIN{printf \"%.1f\", $_jg_mib/1024}")"
  unset _jg_mib
fi
: "${SINGLE_GPU_GIB:=79.6}"
_jg_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
_jg_model="${MODEL:-${MODELS_DIR:-}/Qwen3-4B-Instruct-2507}"
if _jg_split="$(PYTHONPATH="$_jg_root${PYTHONPATH:+:$PYTHONPATH}" python3 -m ga_grpo.model_profile \
      "$_jg_model" --single-rank-shell "$SINGLE_GPU_GIB" 2>/dev/null)"; then
  eval "$_jg_split"
else
  echo "[single_h100] no model profile for $_jg_model; 4B memory split (FSDP_OFFLOAD=optimizer, VLLM_UTIL=0.50)" >&2
fi
unset _jg_root _jg_model _jg_split
: "${FSDP_OFFLOAD:=optimizer}" "${VLLM_UTIL:=0.50}"
# Full-prompt prefill chunks (the multi-GPU defaults); CUDA graphs on.
: "${VLLM_MAX_BATCHED_TOKENS:=10000}" "${VLLM_ENFORCE_EAGER:=0}"
: "${OMP_NUM_THREADS:=16}" "${MKL_NUM_THREADS:=16}" "${TOKENIZERS_PARALLELISM:=false}"
# Rollout runners (scripts/train.sh NUM_RUNNERS): the Ray CPU budget less the
# hybrid bundle (1), the router actor (1) and 4 for the engine's and the Rust
# router's own threads, 2..16. Runners idle while the actor trains and the
# actor idles while they roll out, so neither competes with OMP_NUM_THREADS.
if [ -z "${NUM_RUNNERS:-}" ]; then
  NUM_RUNNERS=$(( RAY_NUM_CPUS - 6 ))
  (( NUM_RUNNERS >= 2 )) || NUM_RUNNERS=2
  (( NUM_RUNNERS <= 16 )) || NUM_RUNNERS=16
fi
: "${TORCH_COMPILE_DISABLE:=1}" "${PYTORCH_CUDA_ALLOC_CONF:=expandable_segments:False}"
export HYBRID ACTOR_GPUS VLLM_ENGINES ISOLATED_RAY RAY_NUM_GPUS RAY_NUM_CPUS NUM_GPUS EVAL_GPU_COUNT GPU_IDS
export ALLOW_NON_LUSTRE ATTN_IMPLEMENTATION PACKING CUDNN_FRONTEND_CUDART_LIB_NAME FSDP_OFFLOAD
export SINGLE_GPU_GIB VLLM_UTIL VLLM_MAX_BATCHED_TOKENS VLLM_ENFORCE_EAGER
export OMP_NUM_THREADS MKL_NUM_THREADS TOKENIZERS_PARALLELISM TORCH_COMPILE_DISABLE PYTORCH_CUDA_ALLOC_CONF NUM_RUNNERS
