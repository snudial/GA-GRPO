# One H100 GPU: shared actor and rollout engine; check model admission first.
: "${HYBRID:=1}" "${ACTOR_GPUS:=1}" "${VLLM_ENGINES:=1}" "${ISOLATED_RAY:=1}"
: "${RAY_NUM_GPUS:=1}" "${RAY_NUM_CPUS:=12}" "${NUM_GPUS:=1}" "${EVAL_GPU_COUNT:=1}" "${GPU_IDS:=0}"
: "${ALLOW_NON_LUSTRE:=1}"
: "${ATTN_IMPLEMENTATION:=sdpa}" "${PACKING:=0}"
: "${FSDP_OFFLOAD:=optimizer}"
: "${VLLM_UTIL:=0.30}" "${VLLM_MAX_BATCHED_TOKENS:=2048}" "${VLLM_ENFORCE_EAGER:=1}"
: "${OMP_NUM_THREADS:=4}" "${MKL_NUM_THREADS:=4}" "${TOKENIZERS_PARALLELISM:=false}"
: "${TORCH_COMPILE_DISABLE:=1}" "${PYTORCH_CUDA_ALLOC_CONF:=expandable_segments:False}"
export HYBRID ACTOR_GPUS VLLM_ENGINES ISOLATED_RAY RAY_NUM_GPUS RAY_NUM_CPUS NUM_GPUS EVAL_GPU_COUNT GPU_IDS
export ALLOW_NON_LUSTRE ATTN_IMPLEMENTATION PACKING FSDP_OFFLOAD
export VLLM_UTIL VLLM_MAX_BATCHED_TOKENS VLLM_ENFORCE_EAGER
export OMP_NUM_THREADS MKL_NUM_THREADS TOKENIZERS_PARALLELISM TORCH_COMPILE_DISABLE PYTORCH_CUDA_ALLOC_CONF
