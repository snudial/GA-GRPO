# Four H100 GPUs: hybrid FSDP actor and four rollout engines.
# CPU optimizer offload supports the 8B profile.
: "${HYBRID:=1}" "${ACTOR_GPUS:=4}" "${VLLM_ENGINES:=4}"
: "${RAY_NUM_GPUS:=4}" "${NUM_GPUS:=4}" "${EVAL_GPU_COUNT:=4}" "${GPU_IDS:=0,1,2,3}"
: "${FSDP_OFFLOAD:=none}"
: "${ALLOW_NON_LUSTRE:=1}"
: "${VLLM_UTIL:=0.70}"
: "${VLLM_PREFIX_CACHING:=1}"
: "${APPWORLD_VLLM_UTIL_4B:=0.70}"
: "${APPWORLD_FSDP_OFFLOAD_8B:=optimizer}" "${APPWORLD_VLLM_UTIL_8B:=0.70}"
: "${APPWORLD_VLLM_UTIL_1P7B:=0.70}" "${APPWORLD_VLLM_UTIL_0P6B:=0.70}"
export HYBRID ACTOR_GPUS VLLM_ENGINES RAY_NUM_GPUS NUM_GPUS EVAL_GPU_COUNT GPU_IDS
export FSDP_OFFLOAD ALLOW_NON_LUSTRE VLLM_UTIL VLLM_PREFIX_CACHING APPWORLD_VLLM_UTIL_4B
export APPWORLD_FSDP_OFFLOAD_8B APPWORLD_VLLM_UTIL_8B APPWORLD_VLLM_UTIL_1P7B APPWORLD_VLLM_UTIL_0P6B
